{
  "name": "drantis",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "playwright test",
    "cli": "tsx packages/cli/src/bin.ts",
    "self:analyze": "tsx packages/cli/src/bin.ts analyze . --json .drantis/self-report.json",
    "verify:rc:windows": "node scripts/verify-release.mjs",
    "verify:release": "node scripts/verify-release.mjs --e2e --docker",
    "verify:scenarios": "node scripts/assert-release-scenarios.mjs",
    "build:cli": "npm run build -w @launchproof/cli",
    "pack:cli": "npm pack -w @launchproof/cli --dry-run",
    "verify:rc": "node scripts/verify-release.mjs",
    "verify:scanners": "node scripts/assert-scanner-fixtures.mjs",
    "verify:isolated-runner": "tsx scripts/verify-isolated-runner.mts",
    "verify:senten-interop": "node scripts/assert-senten-interop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.26",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "type": "module",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
